{
    "name": "links-bi-prototype",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc -b && vite build",
        "build:nocheck": "vite build",
        "format": "prettier --write --ignore-unknown .",
        "format:check": "prettier --check --ignore-unknown .",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview",
        "test": "vitest run --project=unit",
        "test:watch": "vitest",
        "test:browser": "vitest run --project=browser",
        "test:unit": "vitest run --project=unit",
        "test:full": "vitest run",
        "check": "prettier --write --log-level error . && eslint --quiet . && npm run typecheck && npm run test:unit > /dev/null 2>&1"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^2.0.39",
        "@duckdb/duckdb-wasm": "^1.30.1-dev2.0",
        "@glideapps/glide-data-grid": "^6.0.3",
        "@heroicons/react": "^2.2.0",
        "@maplibre/maplibre-gl-style-spec": "^23.3.0",
        "@types/react-grid-layout": "^1.3.5",
        "@viz-js/viz": "^3.16.0",
        "ai": "^5.0.82",
        "apache-arrow": "^21.0.0",
        "html2canvas": "^1.4.1",
        "jotai": "^2.13.1",
        "jstat": "^1.9.6",
        "lodash": "^4.17.21",
        "lz-string": "^1.5.0",
        "maplibre-gl": "^5.3.1",
        "marked": "^4.3.0",
        "ml-matrix": "^6.12.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-grid-layout": "^1.5.2",
        "react-markdown": "^10.1.0",
        "react-responsive-carousel": "^3.2.23",
        "react-vega": "^7.6.0",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "sql-formatter": "^15.6.6",
        "sqloflow": "^0.1.4",
        "tailwindcss": "^4.1.11",
        "vega": "^6.1.2",
        "vega-lite": "^6.1.0",
        "zod": "^3.25.65"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@tailwindcss/vite": "^4.1.11",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react-swc": "^3.8.0",
        "@vitest/browser": "^2.1.9",
        "@vitest/ui": "^2.1.8",
        "eslint": "^9.21.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "jsdom": "^26.1.0",
        "playwright": "^1.54.2",
        "prettier": "^3.6.2",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.24.1",
        "vite": "^6.2.0",
        "vitest": "^2.1.8"
    }
}
