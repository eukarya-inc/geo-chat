{
    "name": "geo-chat",
    "description": "AI agent + GIS workshop material: chat with your geospatial data using DuckDB-WASM, MapLibre and Vega-Lite",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc -b && vite build",
        "build:nocheck": "vite build",
        "format": "prettier --write --ignore-unknown .",
        "format:check": "prettier --check --ignore-unknown .",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview",
        "test": "vitest run --project=unit",
        "test:watch": "vitest",
        "test:browser": "vitest run --project=browser",
        "test:unit": "vitest run --project=unit",
        "test:full": "vitest run --project=unit --project=browser",
        "test:evals": "vitest run --project=evals",
        "check": "prettier --write --log-level error . && eslint --quiet . && npm run typecheck && npm run test:unit > /dev/null 2>&1"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.99",
        "@duckdb/duckdb-wasm": "^1.30.1-dev2.0",
        "@maplibre/maplibre-gl-style-spec": "^23.3.0",
        "@protomaps/basemaps": "^5.7.2",
        "@radix-ui/react-dialog": "^1.1.20",
        "@radix-ui/react-label": "^2.1.12",
        "@radix-ui/react-scroll-area": "^1.2.15",
        "@radix-ui/react-select": "^2.3.4",
        "@radix-ui/react-separator": "^1.1.12",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-tabs": "^1.1.18",
        "@radix-ui/react-tooltip": "^1.2.13",
        "@tanstack/react-virtual": "^3.13.12",
        "ai": "^6.0.233",
        "apache-arrow": "^21.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "jotai": "^2.13.1",
        "lucide-react": "^1.25.0",
        "maplibre-gl": "^5.3.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "^3.0.6",
        "react-vega": "^7.6.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.1.11",
        "tw-animate-css": "^1.4.0",
        "vega": "^6.1.2",
        "vega-lite": "^6.1.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@tailwindcss/vite": "^4.1.11",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react-swc": "^3.8.0",
        "@vitest/browser": "^2.1.9",
        "@vitest/ui": "^2.1.8",
        "eslint": "^9.21.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "jsdom": "^26.1.0",
        "playwright": "^1.56.1",
        "prettier": "^3.6.2",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.24.1",
        "vite": "^7.1.12",
        "vitest": "^2.1.8",
        "vitest-localstorage-mock": "^0.1.2"
    }
}
